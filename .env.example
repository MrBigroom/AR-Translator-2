# Optional cloud translation. Leave empty to use on-device translation only.
# SECURITY: embedding a raw API key in a mobile app is insecure — anyone can
# extract it from the binary. For anything beyond personal use, put a small
# serverless proxy in front and point the app at that instead.
GIFT_CLOUD_TRANSLATE_API_KEY=
# "google" (Cloud Translation v2) or "deepl"
GIFT_CLOUD_TRANSLATE_PROVIDER=google
